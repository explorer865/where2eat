    // =========================================================================
    // 12. DIRECT INTERACTIVE GACHAPON ENGINE (TAP OR DRAG KNOB TO SPIN)
    // =========================================================================
    function refreshGachaponPoolStatus() {
      const pool = getMatchingOutlets();
      const badge = document.getElementById("gachaPoolBadge");
      const emptyAlert = document.getElementById("gachaEmptyAlert");
      const machineWrap = document.getElementById("gachaMachineWrapper");
      const modeTag = state.mode === "couple" ? "Couple Pool" : "Capsules";

      badge.textContent = `${pool.length} ${modeTag} Ready`;

      if (pool.length === 0) {
        const allIgnoringRepeats = getMatchingOutlets({ ignoreRepeats: true });
        emptyAlert.style.display = "flex";
        machineWrap.style.display = "none";
        if (allIgnoringRepeats.length > 0) {
          document.getElementById("gachaEmptyReason").textContent =
            `You've already spun all ${allIgnoringRepeats.length} matching outlets! Uncheck "No repeats" or relax filters to spin again.`;
        } else {
          document.getElementById("gachaEmptyReason").textContent =
            "No outlets match this exact combination of cuisine, location & budget. Tap Relax Filters to broaden your options.";
        }
      } else {
        emptyAlert.style.display = "none";
        machineWrap.style.display = "flex";
      }
    }

    function relaxFilters() {
      soundFX.playTick(540, 0.03);
      if (state.mode === "couple") {
        state.couple.p1.budget = "any";
        state.couple.p2.budget = "any";
        if (getMatchingOutlets().length === 0) {
          state.couple.p1.locationMode = "all";
          state.couple.p2.locationMode = "all";
        }
        if (getMatchingOutlets().length === 0) {
          state.couple.p1.surpriseMe = true;
          state.couple.p2.surpriseMe = true;
        }
      } else {
        if (state.answers.budget !== "any") state.answers.budget = "any";
        if (getMatchingOutlets().length === 0 && state.answers.locationMode !== "all") state.answers.locationMode = "all";
        if (getMatchingOutlets().length === 0) {
          state.answers.surpriseMe = true;
          state.answers.cuisines = [];
          state.answers.excludedCuisines = [];
        }
      }
      refreshGachaponPoolStatus();
    }

    function triggerGachaponSpin() {
      if (state.isSpinning) return;
      const pool = getMatchingOutlets();
      if (pool.length === 0) {
        refreshGachaponPoolStatus();
        return;
      }

      state.isSpinning = true;
      const machineEl = document.getElementById("gachaMachine");
      const statusPill = document.getElementById("gachaStatusPill");
      const knob = document.getElementById("mechanicalKnob");
      const chamber = document.getElementById("capsuleChamber");
      const flap = document.getElementById("chuteFlap");
      const heroCap = document.getElementById("heroCapsule");
      const capTop = document.getElementById("capTopHalf");
      const resultCard = document.getElementById("resultShowcase");

      machineEl.classList.add("spinning", "powered-glow");
      resultCard.classList.remove("visible", "golden-reveal");
      heroCap.classList.remove("visible", "dropping", "opening");

      // Phase 1: Crank Turn
      statusPill.textContent = "Turning the Gachapon crank...";
      knob.classList.add("cranking");
      soundFX.playCrankTurn();

      // Phase 2: Capsule Tumbling inside Globe
      setTimeout(() => {
        statusPill.textContent = "Mixing capsules inside the chamber...";
        chamber.classList.add("tumbling");
        soundFX.playCapsuleRattle(950);
      }, 360);

      // Pick winner & capsule style
      const chosen = pool[Math.floor(Math.random() * pool.length)];
      const roll = Math.random();
      const capsuleType = roll < 0.14 ? "golden" : (roll < 0.34 ? "surprise" : "classic");

      // Phase 3: Capsule Drops Out Chute
      setTimeout(() => {
        chamber.classList.remove("tumbling");
        knob.classList.remove("cranking");
        flap.style.transform = "rotateX(68deg)";
        statusPill.textContent = "Capsule dispensed! Popping it open...";

        if (capsuleType === "golden") {
          capTop.style.background = "linear-gradient(135deg, #FCE89C 0%, #DFAB3E 100%)";
        } else if (capsuleType === "surprise") {
          capTop.style.background = "linear-gradient(135deg, #F6B2C3 0%, #C89CE6 100%)";
        } else {
          capTop.style.background = "linear-gradient(135deg, #F5AAB8 0%, #E28798 100%)";
        }

        heroCap.classList.add("visible", "dropping");
        soundFX.playCapsuleDrop();
        setTimeout(() => { flap.style.transform = "rotateX(0deg)"; }, 450);
      }, 1350);

      // Phase 4: Capsule Opens & Reveals Restaurant
      setTimeout(() => {
        heroCap.classList.add("opening");
        soundFX.playCapsulePopAndChime(capsuleType === "golden");
        statusPill.textContent = "🎉 Your date spot is revealed! Tap knob anytime to spin again";
      }, 2280);

      setTimeout(() => {
        state.isSpinning = false;
        machineEl.classList.remove("spinning", "powered-glow");
        state.currentSpinResult = chosen;
        state.seenIds.add(chosen.id);
        saveSeen();
        renderResultReveal(chosen, capsuleType);
      }, 2760);
    }

    function buildGoogleMapsUrl(outlet) {
      const searchText = outlet.mall && outlet.mall.includes("Precinct") && outlet.unit
        ? `${outlet.name} ${outlet.unit}`
        : `${outlet.name} ${outlet.mall} Singapore`;
      const q = encodeURIComponent(searchText);
      return `https://www.google.com/maps/search/?api=1&query=${q}`;
    }

