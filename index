    function initDirectoryFilters() {
      const mallSel = document.getElementById("dirMallSelect");
      const catSel = document.getElementById("dirCategorySelect");
      const cuisineSel = document.getElementById("dirCuisineSelect");
      const malls = Array.from(new Set(OUTLETS.map(o => o.mall))).sort();
      const cats = Array.from(new Set(OUTLETS.map(o => o.category))).sort();
      const cuisineFamilies = CUISINE_FAMILIES.slice().sort((a, b) => a.label.localeCompare(b.label));

      malls.forEach(m => {
        const opt = document.createElement("option");
        opt.value = m; opt.textContent = `${m} (${getMallRegion(m)})`;
        mallSel.appendChild(opt);
      });
      cats.forEach(c => {
        const opt = document.createElement("option");
        opt.value = c; opt.textContent = c;
        catSel.appendChild(opt);
      });
      cuisineFamilies.forEach(family => {
        const opt = document.createElement("option");
        opt.value = family.id; opt.textContent = family.label;
        cuisineSel.appendChild(opt);
      });

      document.getElementById("registerCountBadge").textContent = MALL_COVERAGE_REGISTER.length;
    }

    function renderDirectoryList() {
      const q = document.getElementById("dirSearchInput").value.trim().toLowerCase();
      const mallFilter = document.getElementById("dirMallSelect").value;
      const catFilter = document.getElementById("dirCategorySelect").value;
      const cuisineFilter = document.getElementById("dirCuisineSelect").value;

      const filtered = OUTLETS.filter(o => {
        if (mallFilter !== "ALL" && o.mall !== mallFilter) return false;
        if (catFilter !== "ALL" && o.category !== catFilter) return false;
        if (cuisineFilter !== "ALL" && !matchesCuisineFamily(o, cuisineFilter)) return false;
        if (q) {
          const hay = `${o.name} ${o.mall} ${getMallRegion(o.mall)} ${o.category} ${o.cuisine.join(" ")}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      document.getElementById("dirCountLabel").textContent = `Showing ${filtered.length} of ${OUTLETS.length} verified outlets`;
      const container = document.getElementById("dirListContainer");

      if (filtered.length === 0) {
        container.innerHTML = `<div class="empty-alert"><h4>No matching outlets</h4><p>Try clearing your search or switching malls.</p></div>`;
        return;
      }

      container.innerHTML = filtered.slice(0, 120).map(o => {
        const isSaved = state.bookmarks.some(b => b.id === o.id);
        const hasDishes = Boolean(getVerifiedMustOrderDishes(o.name, o.mustOrderDishes));
        return `
          <div class="outlet-card">
            <div class="outlet-main">
              <h4>${o.name} ${hasDishes ? '<span title="Has verified must-order picks" style="font-size:0.75rem;">🍽️</span>' : ''}</h4>
              <div class="outlet-meta">
                <strong>${o.mall}</strong>${o.unit ? ` (${o.unit})` : ""} • ${o.category}<br/>
                ${o.cuisine.join(" • ")}
              </div>
            </div>
            <div class="outlet-actions">
              <button class="mini-circle-btn" data-spin-outlet="${o.id}" title="Reveal in Gachapon">🎰</button>
              <button class="mini-circle-btn" data-toggle-save="${o.id}" title="Save Bookmark">${isSaved ? "❤️" : "🤍"}</button>
              <a class="mini-circle-btn" href="${buildGoogleMapsUrl(o)}" target="_blank" rel="noopener noreferrer" title="Google Maps">🗺️</a>
            </div>
          </div>
        `;
      }).join("") + (filtered.length > 120 ? `<div style="text-align:center; font-size:0.78rem; color:var(--brown-soft); padding:8px;">Showing first 120 matches — refine search to narrow down.</div>` : "");

      container.querySelectorAll("[data-toggle-save]").forEach(btn => {
        btn.addEventListener("click", () => {
          toggleBookmarkById(btn.dataset.toggleSave);
          renderDirectoryList();
        });
      });

      container.querySelectorAll("[data-spin-outlet]").forEach(btn => {
        btn.addEventListener("click", () => {
          const found = OUTLETS.find(x => x.id === btn.dataset.spinOutlet);
          if (found) {
            state.currentSpinResult = found;
            switchView("gachapon");
            renderResultReveal(found, "classic");
          }
        });
      });
    }

    function renderMallCoverageRegister() {
      const regFilter = document.getElementById("regRegionFilter").value;
      const list = MALL_COVERAGE_REGISTER.filter(m => regFilter === "ALL" || m.region === regFilter);
      const container = document.getElementById("registerListContainer");

      container.innerHTML = list.map(m => {
