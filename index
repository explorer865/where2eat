          btn.addEventListener("click", () => {
            soundFX.playTick(580, 0.03);
            ansObj.budget = btn.dataset.budget;
            onNextStep();
          });
        });
        return;
      }

      if (stepNum === 4) {
        const isCouplePersona = Boolean(personaLabel);
        const matchingCount = isCouplePersona ? null : getMatchingOutlets().length;
        const cuisineLabel = ansObj.surpriseMe ? "Surprise Me (All)" : (ansObj.cuisines.join(", ") || "All");
        const locLabel = ansObj.locationMode === "mall" ? ansObj.selectedMall : (ansObj.locationMode === "region" ? `${ansObj.selectedRegion} SG` : "All Singapore");

        container.innerHTML = `
