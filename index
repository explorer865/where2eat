              <div class="compat-tile-label">Matchmaker</div>
              <div class="compat-tile-val">💞 Blends Overlap</div>
            </div>
            <div class="compat-tile">
              <div class="compat-tile-label">Gachapon</div>
              <div class="compat-tile-val">🎰 Spins Your Spot</div>
            </div>
          </div>
          <button type="button" class="primary-cta" id="startCoupleP1Btn">Start Person 1's Turn →</button>
        `;
        document.getElementById("startCoupleP1Btn").addEventListener("click", () => {
          soundFX.playTick(620, 0.035);
          c.phase = "p1"; c.step = 1; c.showAllCuisines = false;
          renderCouplePhase();
        });
        return;
      }

      if (c.phase === "p1") {
        topbar.style.display = "flex";
        badge.className = "step-badge";
        badge.textContent = `Person 1 • ${c.step} of 4`;
        fill.style.width = `${(c.step / 4) * 100}%`;
        renderQuestionBody(stage, c.p1, c.step, {
