    function toggleBookmarkById(id) {
      const idx = state.bookmarks.findIndex(b => b.id === id);
      if (idx >= 0) {
        state.bookmarks.splice(idx, 1);
        soundFX.playTick(400, 0.03);
      } else {
        const outlet = OUTLETS.find(o => o.id === id);
        if (outlet) {
          state.bookmarks.unshift(outlet);
          soundFX.playTick(680, 0.04);
        }
      }
      saveBookmarks();
      if (state.currentSpinResult && state.currentSpinResult.id === id) {
        const isSaved = state.bookmarks.some(b => b.id === id);
        document.getElementById("resSaveBtn").textContent = isSaved ? "❤️ Saved in favourites" : "🤍 Save to favourites";
      }
      renderBookmarksList();
    }

