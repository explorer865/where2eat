            <div style="font-size:0.75rem; font-weight:800; color:var(--brown-soft); text-transform:uppercase; letter-spacing:0.04em;">
              ${personaLabel ? `${personaLabel}'s Preferences` : "Your Date Recap"}
            </div>
            <div class="recap-chips">
              <span class="recap-chip">🍴 ${cuisineLabel}</span>
              <span class="recap-chip">📍 ${locLabel}</span>
              <span class="recap-chip">💰 ${ansObj.budget.toUpperCase()}</span>
              ${ansObj.excludedCuisines.length ? `<span class="recap-chip">🚫 No ${ansObj.excludedCuisines.join(", ")}</span>` : ""}
            </div>
          </div>
          ${!isCouplePersona ? `
            <div class="pool-banner">
              🎰 <strong>${matchingCount}</strong> matching restaurant${matchingCount === 1 ? "" : "s"} loaded into the Gachapon!
