          <button type="button" class="primary-cta" id="qStep1NextBtn" ${canProceed ? "" : "disabled"}>Continue →</button>
        `;

        container.querySelectorAll(".cuisine-card[data-fam]").forEach(card => {
          card.addEventListener("click", () => {
