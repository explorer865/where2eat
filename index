    function matchesCuisineFamily(outlet, familyId) {
      const fam = CUISINE_FAMILIES.find(f => f.id === familyId);
      if (!fam) return false;
      const tags = outlet.cuisine.map(c => c.toLowerCase());
      // One-way matching only: a short tag such as "Tea" must never match
      // a longer keyword such as "mala steamboat". Reverse substring matching
      // caused unrelated cafes and restaurants to enter cuisine pools.
      return tags.some(tag => fam.keywords.some(kw => tag.includes(kw)));
    }

    function inferBudgetTier(outlet) {
      const cat = outlet.category.toLowerCase();
      const tags = outlet.cuisine.map(c => c.toLowerCase());
      const name = outlet.name.toLowerCase();
      if (cat === "hawker / food court" || cat === "quick service / fast casual" || cat === "dessert / bakery") return "budget";
      if (cat === "cafe") {
        if (tags.some(t => t.includes("brunch") || t.includes("afternoon tea") || t.includes("modern european")) || ["ps.cafe", "privé", "surrey hills", "alice boulangerie", "marmalade", "twg", "bacha", "prada", "nesuto", "little farms", "dewgather", "koko kawane"].some(k => name.includes(k))) return "mid";
        return "budget";
      }
      if (tags.some(t => ["fine dining", "steakhouse", "wagyu", "peking duck", "seafood", "kaiseki"].some(k => t.includes(k))) || ["1-atico", "jumbo", "imperial treasure", "yong fu", "kuroki", "tajimaya", "angus house", "coach restaurant", "dancing crab", "wolfgang", "shin minori", "joie", "noka", "umenohana", "cut by", "bread street", "koma", "lavo", "chikuyotei", "yantra", "nozomi", "long beach"].some(k => name.includes(k))) return "splurge";
      return "mid";
    }

    function matchesBudget(outlet, budgetChoice) {
      if (!budgetChoice || budgetChoice === "any") return true;
      const tier = inferBudgetTier(outlet);
      if (budgetChoice === "budget") return tier === "budget";
      if (budgetChoice === "mid") return tier === "mid" || tier === "budget";
      if (budgetChoice === "splurge") return tier === "splurge" || tier === "mid";
      return true;
    }

