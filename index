    // =========================================================================
    // 14. NAVIGATION & EVENT WIRING
    // =========================================================================
    function switchView(viewName) {
      state.currentView = viewName;
      document.querySelectorAll(".nav-tab").forEach(tab => {
        tab.classList.toggle("active", tab.dataset.view === viewName);
      });
      document.querySelectorAll(".view-panel").forEach(panel => {
        panel.classList.toggle("active", panel.id === `view-${viewName}`);
      });

      if (viewName === "gachapon") refreshGachaponPoolStatus();
      else if (viewName === "directory") {
        renderDirectoryList();
        renderMallCoverageRegister();
      } else if (viewName === "bookmarks") {
        renderBookmarksList();
      }
    }

    function wireEvents() {
      // Top Nav Tabs
      document.querySelectorAll(".nav-tab").forEach(tab => {
        tab.addEventListener("click", () => {
          soundFX.playTick(540, 0.02);
          switchView(tab.dataset.view);
        });
      });

      // Solo vs Couple Mode Switcher
      document.getElementById("selectSoloModeBtn").addEventListener("click", () => {
        soundFX.playTick(560, 0.03);
        setActiveMode("solo");
      });
      document.getElementById("selectCoupleModeBtn").addEventListener("click", () => {
        soundFX.playTick(640, 0.035);
        setActiveMode("couple");
      });

      // Solo Wizard Navigation
      document.getElementById("stepBackBtn").addEventListener("click", () => {
        if (state.currentStep > 1) {
          soundFX.playTick(480, 0.02);
          state.currentStep--;
          renderSoloStep();
        }
      });
      document.getElementById("stepRestartBtn").addEventListener("click", () => {
        soundFX.playTick(440, 0.03);
        state.currentStep = 1;
        state.answers = createDefaultAnswers();
        renderSoloStep();
      });

      // Couple Wizard Navigation
      document.getElementById("coupleBackBtn").addEventListener("click", () => {
        const c = state.couple;
        soundFX.playTick(480, 0.02);
        if (c.phase === "p1") {
          if (c.step > 1) c.step--;
          else c.phase = "intro";
        } else if (c.phase === "p2") {
          if (c.step > 1) c.step--;
          else c.phase = "handoff";
        }
        renderCouplePhase();
      });
      document.getElementById("coupleRestartBtn").addEventListener("click", () => {
        soundFX.playTick(440, 0.03);
        state.couple.phase = "intro";
        state.couple.step = 1;
        state.couple.p1 = createDefaultAnswers();
        state.couple.p2 = createDefaultAnswers();
        renderCouplePhase();
      });

      // Direct Interactive Gachapon Machine (Tap/Click, Touch Drag/Swipe on Knob, or Keyboard Enter/Space)
      const machineEl = document.getElementById("gachaMachine");
      let pointerStartX = null;
      let pointerStartY = null;

      machineEl.addEventListener("pointerdown", (e) => {
        pointerStartX = e.clientX;
        pointerStartY = e.clientY;
      });
      machineEl.addEventListener("pointerup", (e) => {
        if (pointerStartX !== null && pointerStartY !== null) {
          const dist = Math.hypot(e.clientX - pointerStartX, e.clientY - pointerStartY);
          pointerStartX = null;
          pointerStartY = null;
          if (dist < 140) triggerGachaponSpin();
        }
      });
      machineEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          triggerGachaponSpin();
        }
      });

      // Gachapon Controls
      document.getElementById("excludeSeenCheckbox").addEventListener("change", refreshGachaponPoolStatus);
      document.getElementById("editPrefsFromGachaBtn").addEventListener("click", () => switchView("flow"));
      document.getElementById("relaxFiltersBtn").addEventListener("click", relaxFilters);
      document.getElementById("backToQuestionsBtn").addEventListener("click", () => switchView("flow"));

      // Result Card Actions
      document.getElementById("resSaveBtn").addEventListener("click", () => {
        if (state.currentSpinResult) toggleBookmarkById(state.currentSpinResult.id);
      });
      document.getElementById("resTryAnotherBtn").addEventListener("click", () => {
        document.getElementById("gachaMachineWrapper").scrollIntoView({ behavior: "smooth", block: "center" });
        setTimeout(() => triggerGachaponSpin(), 220);
      });
      document.getElementById("resChangePrefsBtn").addEventListener("click", () => switchView("flow"));

      // Directory Sub-view Switcher & Filters
      document.getElementById("showOutletsSubBtn").addEventListener("click", () => {
        document.getElementById("dirOutletsSubView").style.display = "flex";
        document.getElementById("dirRegisterSubView").style.display = "none";
        document.getElementById("showOutletsSubBtn").style.background = "var(--cream-soft)";
        document.getElementById("showRegisterSubBtn").style.background = "transparent";
      });
      document.getElementById("showRegisterSubBtn").addEventListener("click", () => {
        document.getElementById("dirOutletsSubView").style.display = "none";
        document.getElementById("dirRegisterSubView").style.display = "flex";
        document.getElementById("showRegisterSubBtn").style.background = "var(--cream-soft)";
        document.getElementById("showOutletsSubBtn").style.background = "transparent";
        renderMallCoverageRegister();
      });

      document.getElementById("dirSearchInput").addEventListener("input", renderDirectoryList);
      document.getElementById("dirMallSelect").addEventListener("change", renderDirectoryList);
      document.getElementById("dirCategorySelect").addEventListener("change", renderDirectoryList);
      document.getElementById("dirCuisineSelect").addEventListener("change", renderDirectoryList);
      document.getElementById("regRegionFilter").addEventListener("change", renderMallCoverageRegister);

      // Sound & Settings Actions
      const toggleSound = () => {
        soundFX.enabled = !soundFX.enabled;
        try { localStorage.setItem(STORAGE_KEYS.SOUND, String(soundFX.enabled)); } catch (e) {}
        syncSoundUI();
        if (soundFX.enabled) soundFX.playTick(660, 0.04);
      };
      document.getElementById("quickSoundBtn").addEventListener("click", toggleSound);
      document.getElementById("settingsSoundSwitch").addEventListener("click", toggleSound);

      document.getElementById("clearSeenBtn").addEventListener("click", () => {
        state.seenIds.clear();
        saveSeen();
        refreshGachaponPoolStatus();
        const btn = document.getElementById("clearSeenBtn");
        btn.textContent = "✓ Cleared";
        setTimeout(() => { btn.textContent = "Reset History"; }, 1400);
      });

      document.getElementById("clearBookmarksBtn").addEventListener("click", () => {
        state.bookmarks = [];
        saveBookmarks();
        renderBookmarksList();
        const btn = document.getElementById("clearBookmarksBtn");
        btn.textContent = "✓ Cleared";
        setTimeout(() => { btn.textContent = "Clear List"; }, 1400);
      });
    }

    // =========================================================================
    // 15. INITIALIZE APPLICATION
    // =========================================================================
    window.addEventListener("DOMContentLoaded", () => {
      loadPersistentState();
      syncSoundUI();
      saveBookmarks();

      const uniqueMallsCount = new Set(OUTLETS.map(o => o.mall)).size;
      document.getElementById("headerStatsSub").textContent =
        `${OUTLETS.length} Verified Outlets • ${uniqueMallsCount} Malls & Precincts Across SG`;

      initDirectoryFilters();
      wireEvents();
      renderSoloStep();
    });
  </script>
</body>
</html>
