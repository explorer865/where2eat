<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Where2Eat ❤️ — Romantic Gachapon Dining Date</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream-bg: #FCF8F3;
      --cream-soft: #F6EDE3;
      --latte-card: #FFFDFB;
      --latte-tint: #F2E4D6;
      --blush: #F7D8DD;
      --blush-deep: #E5A4B0;
      --dusty-rose: #D47889;
      --dusty-rose-hover: #C26577;
      --peach: #FADFD0;
      --peach-deep: #E8B194;
      --gold-soft: #FBF0CF;
      --gold-deep: #CF9B34;
      --brown-ink: #3E2E28;
      --brown-soft: #755F56;
      --brown-muted: #9E887E;
      --sage: #DAE6D8;
      --sage-text: #456048;
      --border-soft: #E9D9CC;
      --border-subtle: rgba(233, 217, 204, 0.72);
      --shadow-xs: 0 2px 8px rgba(78, 54, 43, 0.04);
      --shadow-sm: 0 6px 18px rgba(78, 54, 43, 0.06);
      --shadow-warm: 0 14px 36px rgba(78, 54, 43, 0.08);
      --shadow-rose: 0 10px 26px rgba(212, 120, 137, 0.28);
      --radius-xl: 28px;
      --radius-lg: 20px;
      --radius-md: 15px;
      --radius-sm: 12px;
      --radius-pill: 999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background:
        radial-gradient(circle at 10% 6%, rgba(247, 216, 221, 0.48) 0%, transparent 40%),
        radial-gradient(circle at 90% 14%, rgba(250, 223, 208, 0.52) 0%, transparent 44%),
        radial-gradient(circle at 50% 94%, rgba(242, 228, 214, 0.65) 0%, transparent 52%),
        var(--cream-bg);
      color: var(--brown-ink);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 20px 16px 56px;
      line-height: 1.52;
      -webkit-font-smoothing: antialiased;
    }

    .app-shell {
      width: 100%;
      max-width: 540px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* ===================================================================== */
    /* HEADER                                                                */
    /* ===================================================================== */
    .top-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 4px;
      gap: 12px;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .brand-emblem {
      width: 46px;
      height: 46px;
      border-radius: 16px;
      background: linear-gradient(145deg, #F9DCE1 0%, #FBE2D3 100%);
      border: 1.5px solid rgba(212, 120, 137, 0.26);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(212, 120, 137, 0.16), inset 0 2px 4px rgba(255, 255, 255, 0.8);
    }
    .brand-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 1.48rem;
      font-weight: 700;
      color: var(--brown-ink);
      letter-spacing: -0.025em;
      line-height: 1.15;
    }
    .brand-sub {
      font-size: 0.74rem;
      color: var(--brown-soft);
      font-weight: 600;
      margin-top: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .header-pills { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .icon-pill-btn {
      background: var(--latte-card);
      border: 1.5px solid var(--border-soft);
      color: var(--brown-ink);
      border-radius: var(--radius-pill);
      padding: 8px 13px;
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: var(--shadow-xs);
      transition: all 0.18s ease;
    }
    .icon-pill-btn:hover { background: var(--cream-soft); border-color: var(--blush-deep); }
    .icon-pill-btn:active { transform: scale(0.96); }

    /* ===================================================================== */
    /* NAVIGATION TABS                                                       */
    /* ===================================================================== */
    .nav-bar {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      background: rgba(246, 237, 227, 0.85);
      backdrop-filter: blur(8px);
      padding: 5px;
      border-radius: var(--radius-pill);
      border: 1px solid var(--border-soft);
      gap: 4px;
      box-shadow: inset 0 1px 3px rgba(78, 54, 43, 0.04);
    }
    .nav-tab {
      border: none;
      background: transparent;
      color: var(--brown-soft);
      font-family: inherit;
      font-size: 0.76rem;
      font-weight: 700;
      padding: 10px 4px;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      white-space: nowrap;
    }
    .nav-tab:hover:not(.active) { color: var(--brown-ink); }
    .nav-tab.active {
      background: var(--latte-card);
      color: var(--brown-ink);
      box-shadow: 0 4px 12px rgba(78, 54, 43, 0.09);
    }

    /* ===================================================================== */
    /* SOLO VS COUPLE MODE SWITCHER                                          */
    /* ===================================================================== */
    .mode-switcher-bar { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .mode-card-btn {
      background: var(--latte-card);
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 13px 14px;
      display: flex;
      align-items: center;
      gap: 11px;
      cursor: pointer;
      text-align: left;
      transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: var(--shadow-xs);
    }
    .mode-card-btn:hover { border-color: var(--blush-deep); transform: translateY(-1px); }
    .mode-card-btn.active {
      background: linear-gradient(135deg, #FCECEF 0%, #FDF3EB 100%);
      border-color: var(--dusty-rose);
      box-shadow: 0 8px 20px rgba(212, 120, 137, 0.18);
    }
    .mode-card-btn.couple-btn.active {
      background: linear-gradient(135deg, #FBDCE2 0%, #FDE9DC 100%);
      border-color: var(--dusty-rose);
    }
    .mode-icon-circle {
      width: 38px;
      height: 38px;
      border-radius: 13px;
      background: var(--cream-bg);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      flex-shrink: 0;
      box-shadow: var(--shadow-xs);
    }
    .mode-label { font-size: 0.88rem; font-weight: 800; color: var(--brown-ink); line-height: 1.2; }
    .mode-hint { font-size: 0.71rem; color: var(--brown-soft); font-weight: 600; margin-top: 2px; }

    /* ===================================================================== */
    /* SURFACE CARDS & PANELS                                                */
    /* ===================================================================== */
    .surface-card {
      background: var(--latte-card);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-xl);
      padding: 24px 20px;
      box-shadow: var(--shadow-warm);
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .couple-surface {
      background: linear-gradient(180deg, #FFFDFB 0%, #FDF4F3 100%);
      border: 1.5px solid var(--blush-deep);
    }
    .view-panel {
      display: none;
      flex-direction: column;
      gap: 16px;
      animation: fadeSlideUp 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .view-panel.active { display: flex; }
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ===================================================================== */
    /* STEP WIZARD TOPBAR & HEADINGS                                         */
    /* ===================================================================== */
    .step-topbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .step-badge {
      background: var(--blush);
      color: var(--brown-ink);
      font-size: 0.73rem;
      font-weight: 800;
      padding: 5px 12px;
      border-radius: var(--radius-pill);
      white-space: nowrap;
      letter-spacing: 0.01em;
    }
    .step-badge.p2 { background: var(--peach); }
    .progress-track {
      flex: 1;
      height: 7px;
      background: var(--cream-soft);
      border-radius: var(--radius-pill);
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      width: 20%;
      background: linear-gradient(90deg, var(--blush-deep), var(--dusty-rose));
      border-radius: var(--radius-pill);
      transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .step-nav-actions { display: flex; align-items: center; gap: 6px; }
    .ghost-pill {
      background: var(--latte-card);
      border: 1px solid var(--border-soft);
      color: var(--brown-soft);
      font-family: inherit;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 6px 12px;
      border-radius: var(--radius-pill);
      cursor: pointer;
      transition: all 0.18s ease;
    }
    .ghost-pill:hover { background: var(--cream-soft); color: var(--brown-ink); border-color: var(--blush-deep); }
    .ghost-pill:disabled { opacity: 0.38; cursor: not-allowed; }

    .question-header { display: flex; flex-direction: column; gap: 5px; }
    .question-kicker {
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--dusty-rose);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .question-title {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 1.42rem;
      font-weight: 600;
      color: var(--brown-ink);
      line-height: 1.25;
      letter-spacing: -0.015em;
    }
    .question-desc { font-size: 0.85rem; color: var(--brown-soft); line-height: 1.48; }

    /* ===================================================================== */
    /* CUISINE CARDS GRID                                                    */
    /* ===================================================================== */
    .cuisine-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @media (max-width: 390px) { .cuisine-grid { grid-template-columns: repeat(2, 1fr); } }
    .cuisine-card {
      background: var(--cream-bg);
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 13px 8px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 6px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      position: relative;
      user-select: none;
    }
    .cuisine-card:hover { transform: translateY(-2px); border-color: var(--blush-deep); background: #FFF9F5; }
    .cuisine-card:active { transform: scale(0.96); }
    .cuisine-card.selected {
      background: linear-gradient(145deg, #FCECEF 0%, #FDF2EA 100%);
      border-color: var(--dusty-rose);
      box-shadow: 0 6px 16px rgba(212, 120, 137, 0.2);
      transform: translateY(-2px);
    }
    .cuisine-card.selected::after {
      content: "✓";
      position: absolute;
      top: 7px;
      right: 8px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--dusty-rose);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cuisine-card.excluded.selected { background: #FFF1F0; border-color: #C95B63; }
    .cuisine-card.excluded.selected::after { content: "✕"; background: #C95B63; }
    .cuisine-card.surprise {
      background: linear-gradient(145deg, #FADFD0 0%, #F7D8DD 100%);
      border-color: rgba(212, 120, 137, 0.45);
    }
    .cuisine-icon {
      width: 38px;
      height: 38px;
      border-radius: 13px;
      background: var(--latte-card);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.22rem;
      box-shadow: var(--shadow-xs);
    }
    .cuisine-name { font-size: 0.8rem; font-weight: 700; color: var(--brown-ink); line-height: 1.2; }
    .cuisine-count { font-size: 0.68rem; color: var(--brown-muted); font-weight: 600; }
    .more-cuisines-row { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; }

    /* ===================================================================== */
    /* OPTION CHOICE CARDS                                                   */
    /* ===================================================================== */
    .choice-stack { display: flex; flex-direction: column; gap: 10px; }
    .choice-card {
      background: var(--cream-bg);
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      gap: 13px;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      width: 100%;
    }
    .choice-card:hover { border-color: var(--blush-deep); background: #FFF9F5; transform: translateX(2px); }
    .choice-card:active { transform: scale(0.985); }
    .choice-card.selected {
      background: linear-gradient(135deg, #FCECEF 0%, #FDF2EA 100%);
      border-color: var(--dusty-rose);
      box-shadow: 0 6px 18px rgba(212, 120, 137, 0.18);
    }
    .choice-emoji {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: var(--latte-card);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.22rem;
      flex-shrink: 0;
      box-shadow: var(--shadow-xs);
    }
    .choice-text { flex: 1; }
    .choice-title { font-size: 0.93rem; font-weight: 700; color: var(--brown-ink); }
    .choice-sub { font-size: 0.77rem; color: var(--brown-soft); margin-top: 2px; }
    .choice-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid var(--border-soft);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      color: transparent;
      flex-shrink: 0;
      transition: all 0.18s ease;
    }
    .choice-card.selected .choice-check { background: var(--dusty-rose); border-color: var(--dusty-rose); color: #fff; }

    /* ===================================================================== */
    /* FORM INPUTS & SUB-PANELS                                              */
    /* ===================================================================== */
    .sub-panel {
      background: var(--cream-soft);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-md);
      padding: 15px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 4px;
    }
    .sub-panel label { font-size: 0.77rem; font-weight: 700; color: var(--brown-soft); }
    .soft-select, .soft-input {
      width: 100%;
      background: var(--latte-card);
      color: var(--brown-ink);
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius-pill);
      padding: 11px 16px;
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 600;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .soft-select:focus, .soft-input:focus {
      border-color: var(--dusty-rose);
      box-shadow: 0 0 0 3px rgba(212, 120, 137, 0.14);
    }

    /* ===================================================================== */
    /* PRIMARY & SECONDARY PILL BUTTONS                                      */
    /* ===================================================================== */
    .primary-cta {
      width: 100%;
      border: none;
      border-radius: var(--radius-pill);
      background: linear-gradient(135deg, #E28A9A 0%, #D47889 52%, #E39E84 100%);
      color: #FFFDFB;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 800;
      padding: 14px 20px;
      cursor: pointer;
      box-shadow: var(--shadow-rose);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s ease;
      letter-spacing: 0.01em;
    }
    .primary-cta:hover:not(:disabled) {
      box-shadow: 0 12px 28px rgba(212, 120, 137, 0.4);
      transform: translateY(-1px);
    }
    .primary-cta:active:not(:disabled) { transform: scale(0.975); }
    .primary-cta:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }

    .secondary-cta {
      border: 1.5px solid var(--border-soft);
      border-radius: var(--radius-pill);
      background: var(--latte-card);
      color: var(--brown-ink);
      font-family: inherit;
      font-size: 0.83rem;
      font-weight: 700;
      padding: 11px 16px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      box-shadow: var(--shadow-xs);
      transition: all 0.18s ease;
    }
    .secondary-cta:hover { background: var(--cream-soft); border-color: var(--blush-deep); }
    .secondary-cta:active { transform: scale(0.97); }

    /* ===================================================================== */
    /* RECAP, COMPATIBILITY & ALERTS                                         */
    /* ===================================================================== */
    .recap-box {
      background: var(--cream-bg);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-lg);
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .recap-chips { display: flex; flex-wrap: wrap; gap: 7px; }
    .recap-chip {
      background: var(--latte-card);
      border: 1px solid var(--border-soft);
      color: var(--brown-ink);
      font-size: 0.77rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: var(--radius-pill);
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .pool-banner {
      background: linear-gradient(135deg, #FCECEF 0%, #FDF2EA 100%);
      border: 1px solid rgba(212, 120, 137, 0.32);
      border-radius: var(--radius-md);
      padding: 13px 15px;
      font-size: 0.85rem;
      color: var(--brown-ink);
      font-weight: 600;
      text-align: center;
    }
    .pool-banner strong { color: var(--dusty-rose); font-weight: 800; }

    .compat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .compat-tile {
      background: var(--cream-bg);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-md);
      padding: 12px 13px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .compat-tile-label {
      font-size: 0.69rem;
      font-weight: 800;
      color: var(--brown-soft);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .compat-tile-val { font-size: 0.84rem; font-weight: 800; color: var(--brown-ink); line-height: 1.35; }

    .empty-alert {
      background: #FFF6F4;
      border: 1.5px solid #EBC1C8;
      border-radius: var(--radius-lg);
      padding: 20px 18px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .empty-alert h4 { font-family: 'Fraunces', Georgia, serif; font-size: 1.12rem; color: var(--brown-ink); }
    .empty-alert p { font-size: 0.84rem; color: var(--brown-soft); }

    /* ===================================================================== */
    /* INTERACTIVE 3D-STYLED JAPANESE GACHAPON MACHINE                       */
    /* ===================================================================== */
    .gacha-stage { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 6px 0 2px; }
    .gacha-status-pill {
      background: var(--cream-soft);
      border: 1px solid var(--border-soft);
      color: var(--brown-soft);
      font-size: 0.81rem;
      font-weight: 700;
      padding: 7px 16px;
      border-radius: var(--radius-pill);
      transition: all 0.25s ease;
      text-align: center;
    }

    .gacha-machine {
      width: 288px;
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      user-select: none;
      cursor: pointer;
      touch-action: manipulation;
      transition: filter 0.35s ease, transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
      outline: none;
    }
    .gacha-machine:hover:not(.spinning) {
      transform: translateY(-2px);
      filter: drop-shadow(0 8px 18px rgba(212, 120, 137, 0.24));
    }
    .gacha-machine:active:not(.spinning) { transform: scale(0.985); }
    .gacha-machine:focus-visible { box-shadow: 0 0 0 4px rgba(212, 120, 137, 0.35); border-radius: 36px; }
    .gacha-machine.spinning { cursor: wait; }
    .gacha-machine.powered-glow { filter: drop-shadow(0 0 22px rgba(229, 164, 176, 0.72)); }

    .machine-cap {
      width: 184px;
      height: 30px;
      background: linear-gradient(180deg, #F7D4DB 0%, #E7A8B2 65%, #D98E9B 100%);
      border-radius: 28px 28px 6px 6px;
      border: 2px solid #D38896;
      box-shadow: inset 0 4px 8px rgba(255, 255, 255, 0.75), 0 4px 10px rgba(78, 54, 43, 0.12);
      position: relative;
      z-index: 4;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .machine-cap::after { content: "WHERE2EAT • SG"; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.14em; color: #613941; }

    .capsule-chamber {
      width: 252px;
      height: 222px;
      margin-top: -4px;
      border-radius: 122px 122px 38px 38px;
      background: radial-gradient(circle at 26% 22%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0.25) 36%, rgba(246, 216, 220, 0.16) 72%, rgba(190, 134, 144, 0.26) 100%);
      border: 3px solid rgba(226, 184, 191, 0.85);
