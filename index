            const fam = card.dataset.fam;
            ansObj.surpriseMe = false;
            // Cuisine preference is deliberately single-select in both Solo
            // and Couple Mode. Choosing another card replaces the prior choice.
            ansObj.cuisines = [fam];
            onToggleMoreCuisines(showAllCuisinesFlag);
          });
        });

        container.querySelector('[data-surprise="true"]').addEventListener("click", () => {
          soundFX.playTick(680, 0.035);
          ansObj.surpriseMe = !ansObj.surpriseMe;
          if (ansObj.surpriseMe) ansObj.cuisines = [];
          onToggleMoreCuisines(showAllCuisinesFlag);
        });

        getQuestionElement("qToggleMoreCuisinesBtn").addEventListener("click", () => {
          onToggleMoreCuisines(!showAllCuisinesFlag);
        });

        getQuestionElement("qStep1NextBtn").addEventListener("click", () => {
          soundFX.playTick(600, 0.03);
          onNextStep();
        });
        return;
      }

      if (stepNum === 2) {
        const mallsList = getAvailableMallsWithCounts();
