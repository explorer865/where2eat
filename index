            ${ansObj.locationDetected ? `<p class="question-desc" style="margin-top:6px;color:var(--green);">Location detected: <strong>${ansObj.locationDetected.region}</strong> region (GPS accuracy about ${Math.round(ansObj.locationDetected.accuracy)} m).</p>` : ""}
