          ansObj.locationError = "";
          const detectBtn = getQuestionElement("qDetectLocationBtn");
          detectBtn.disabled = true;
          detectBtn.textContent = "📍 Detecting your location…";
          if (!navigator.geolocation) {
            ansObj.locationError = "This browser does not support location detection. Please choose a region manually.";
            renderQuestionBody(container, ansObj, 2, { personaLabel, showAllCuisinesFlag, onToggleMoreCuisines, onNextStep, onOpenGachapon });
            return;
          }
          navigator.geolocation.getCurrentPosition(position => {
            const region = getSingaporeRegionFromCoordinates(position.coords.latitude, position.coords.longitude);
            if (!region) {
              ansObj.locationError = "Your detected position appears to be outside Singapore. Please choose a Singapore region manually.";
            } else {
              ansObj.locationMode = "region";
              ansObj.selectedRegion = region;
              ansObj.locationDetected = { region, accuracy: position.coords.accuracy || 0 };
              ansObj.locationError = "";
            }
            renderQuestionBody(container, ansObj, 2, { personaLabel, showAllCuisinesFlag, onToggleMoreCuisines, onNextStep, onOpenGachapon });
          }, error => {
            const message = error.code === 1
              ? "Location permission was denied. Allow location access in your browser or choose a region manually."
              : error.code === 3
                ? "Location detection timed out. Please try again or choose a region manually."
                : "Unable to determine your location. Check your device location settings and try again.";
            ansObj.locationError = message;
            renderQuestionBody(container, ansObj, 2, { personaLabel, showAllCuisinesFlag, onToggleMoreCuisines, onNextStep, onOpenGachapon });
          }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 30000 });
        });

        container.querySelectorAll(".choice-card[data-loc]").forEach(btn => {
          btn.addEventListener("click", () => {
            soundFX.playTick(560, 0.025);
            ansObj.locationMode = btn.dataset.loc;
            ansObj.locationDetected = null;
            ansObj.locationError = "";
            renderQuestionBody(container, ansObj, 2, { personaLabel, showAllCuisinesFlag, onToggleMoreCuisines, onNextStep, onOpenGachapon });
          });
        });

        const regSel = getQuestionElement("qRegionSelect");
        if (regSel) regSel.addEventListener("change", e => {
          ansObj.selectedRegion = e.target.value;
          ansObj.locationDetected = null;
          ansObj.locationError = "";
        });

        const mallSel = getQuestionElement("qMallSelect");
        if (mallSel) mallSel.addEventListener("change", e => { ansObj.selectedMall = e.target.value; });

        getQuestionElement("qStep2NextBtn").addEventListener("click", () => {
          soundFX.playTick(600, 0.03);
          onNextStep();
        });
        return;
      }

      if (stepNum === 3) {
        container.innerHTML = `
          <div class="question-header">
            <div class="question-kicker">${prefix}STEP 3 • BUDGET</div>
            <h2 class="question-title">What's the budget vibe?</h2>
            <p class="question-desc">Tap a comfort tier to continue.</p>
          </div>
          <div class="choice-stack">
            ${BUDGET_OPTIONS.map(b => `
              <button type="button" class="choice-card ${ansObj.budget === b.id ? "selected" : ""}" data-budget="${b.id}">
                <div class="choice-emoji">${b.emoji}</div>
                <div class="choice-text">
                  <div class="choice-title">${b.title}</div>
                  <div class="choice-sub">${b.sub}</div>
