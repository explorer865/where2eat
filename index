    function filterOutletsBySingleAnswers(ans, { ignoreRepeats = false } = {}) {
      const excludeSeen = !ignoreRepeats && document.getElementById("excludeSeenCheckbox")?.checked;
      return OUTLETS.filter(outlet => {
        if (excludeSeen && state.seenIds.has(outlet.id)) return false;
        if (!ans.surpriseMe && ans.cuisines.length > 0) {
          if (!ans.cuisines.some(famId => matchesCuisineFamily(outlet, famId))) return false;
        }
        if (ans.excludedCuisines.length > 0) {
          if (ans.excludedCuisines.some(famId => matchesCuisineFamily(outlet, famId))) return false;
        }
        if (ans.locationMode === "region" && getMallRegion(outlet.mall) !== ans.selectedRegion) return false;
        if (ans.locationMode === "mall" && outlet.mall !== ans.selectedMall) return false;
        if (!matchesBudget(outlet, ans.budget)) return false;
        return true;
      });
