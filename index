          </button>
        `;

        container.querySelectorAll(".cuisine-card[data-exfam]").forEach(card => {
          card.addEventListener("click", () => {
            soundFX.playTick(440, 0.025);
            const fam = card.dataset.exfam;
            const idx = ansObj.excludedCuisines.indexOf(fam);
            if (idx >= 0) ansObj.excludedCuisines.splice(idx, 1);
            else ansObj.excludedCuisines.push(fam);
            renderQuestionBody(container, ansObj, 4, { personaLabel, showAllCuisinesFlag, onToggleMoreCuisines, onNextStep, onOpenGachapon });
          });
        });

        getQuestionElement("qStep4FinishBtn").addEventListener("click", () => {
          soundFX.playTick(680, 0.04);
          if (isCouplePersona) onNextStep();
          else onOpenGachapon();
        });
      }
    }

    // =========================================================================
    // 11. SOLO WIZARD & COUPLE MODE WIZARD CONTROLLERS
    // =========================================================================
    function setActiveMode(newMode) {
      state.mode = newMode;
      const soloBtn = document.getElementById("selectSoloModeBtn");
      const coupleBtn = document.getElementById("selectCoupleModeBtn");
      const soloCard = document.getElementById("soloWizardCard");
      const coupleCard = document.getElementById("coupleWizardCard");

      if (newMode === "solo") {
        soloBtn.classList.add("active");
        coupleBtn.classList.remove("active");
        soloCard.style.display = "flex";
        coupleCard.style.display = "none";
        renderSoloStep();
      } else {
        coupleBtn.classList.add("active");
        soloBtn.classList.remove("active");
        soloCard.style.display = "none";
        coupleCard.style.display = "flex";
        renderCouplePhase();
      }
    }

    function renderSoloStep() {
      const stage = document.getElementById("questionStage");
      document.getElementById("stepCounterText").textContent = `${state.currentStep} of 4`;
      document.getElementById("stepProgressFill").style.width = `${(state.currentStep / 4) * 100}%`;
      document.getElementById("stepBackBtn").disabled = state.currentStep === 1;

      renderQuestionBody(stage, state.answers, state.currentStep, {
        personaLabel: "",
        showAllCuisinesFlag: state.showAllCuisines,
        onToggleMoreCuisines: (flag) => { state.showAllCuisines = flag; renderSoloStep(); },
        onNextStep: () => { if (state.currentStep < 4) { state.currentStep++; renderSoloStep(); } },
        onOpenGachapon: () => switchView("gachapon")
      });
    }

    function renderCouplePhase() {
      const topbar = document.getElementById("coupleTopbar");
      const stage = document.getElementById("coupleStage");
      const badge = document.getElementById("coupleStepBadge");
      const fill = document.getElementById("coupleProgressFill");
      const c = state.couple;

      if (c.phase === "intro") {
        topbar.style.display = "none";
        stage.innerHTML = `
          <div class="question-header" style="text-align:center; align-items:center;">
            <div class="reveal-ribbon">❤️ COUPLE COMPATIBILITY MODE</div>
            <h2 class="question-title" style="font-size:1.52rem;">Two Cravings, One Perfect Spot</h2>
