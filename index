    function getVerifiedMustOrderDishes(outletName, rawDishes = null) {
      let candidates = Array.isArray(rawDishes) ? rawDishes : null;
      if (!candidates) {
        const lower = outletName.toLowerCase();
        for (const [key, dishes] of Object.entries(MUST_ORDER_DB)) {
          if (lower.includes(key) || key.includes(lower)) {
            candidates = dishes;
            break;
          }
        }
      }
      if (!Array.isArray(candidates) || candidates.length === 0) return null;
      const verifiedOnly = candidates.filter(d => d && d.verified === true);
      return verifiedOnly.length > 0 ? verifiedOnly : null;
    }

    // =========================================================================
    // 4. MERGE & DEDUPLICATE DATABASE WITH DETERMINISTIC UNIQUE IDs
    // =========================================================================
    const OUTLETS = (() => {
      const seenKeys = new Set();
      const merged = [];

      BASE_OUTLETS.forEach((item, idx) => {
        const normKey = `${item.name.trim().toLowerCase()}@@${item.mall.trim().toLowerCase()}`;
        if (!seenKeys.has(normKey)) {
          seenKeys.add(normKey);
          merged.push({
            id: `w2e_base_${String(idx + 1).padStart(4, "0")}`,
            name: item.name,
            cuisine: item.cuisine,
            category: item.category,
            mall: item.mall,
            unit: item.unit || null,
            sourceUrl: item.sourceUrl || null,
            mustOrderDishes: getVerifiedMustOrderDishes(item.name, item.mustOrderDishes || null)
          });
        }
      });

      EXPANDED_OUTLETS.forEach((item, idx) => {
        const normKey = `${item.name.trim().toLowerCase()}@@${item.mall.trim().toLowerCase()}`;
        if (!seenKeys.has(normKey)) {
          seenKeys.add(normKey);
          merged.push({
            id: `w2e_exp_${String(idx + 1).padStart(4, "0")}`,
            name: item.name,
            cuisine: item.cuisine,
            category: item.category,
            mall: item.mall,
            unit: item.unit || null,
            sourceUrl: item.sourceUrl || null,
            mustOrderDishes: getVerifiedMustOrderDishes(item.name, item.mustOrderDishes || null)
          });
        }
      });

      return merged;
    })();

    // =========================================================================
    // 4A. CONSERVATIVE CUISINE TAG ENRICHMENT (NO OUTLET RECORDS ADDED/REMOVED)
    // =========================================================================
    // Tags are derived only from explicit existing cuisine labels or explicit
    // dining-style wording in the outlet name. Ambiguous generic "BBQ" labels
    // are deliberately not treated as Korean BBQ or Japanese yakiniku.
    function addCuisineTag(outlet, tag) {
      if (!outlet.cuisine.some(existing => existing.toLowerCase() === tag.toLowerCase())) outlet.cuisine.push(tag);
    }
    OUTLETS.forEach(outlet => {
      const tags = outlet.cuisine.map(tag => String(tag).toLowerCase());
      const name = String(outlet.name).toLowerCase();
      const has = (...terms) => terms.some(term => tags.some(tag => tag.includes(term)) || name.includes(term));

      if (has("korean bbq", "korean barbecue", "kbbq")) {
        addCuisineTag(outlet, "Korean BBQ");
        addCuisineTag(outlet, "KBBQ");
        addCuisineTag(outlet, "Korean");
      }
      if (has("yakiniku", "japanese bbq", "japanese barbecue")) {
        addCuisineTag(outlet, "Yakiniku");
        addCuisineTag(outlet, "Japanese BBQ");
        addCuisineTag(outlet, "Japanese");
      }
      if (has("shabu shabu", "shabu-shabu")) {
        addCuisineTag(outlet, "Shabu-shabu");
        addCuisineTag(outlet, "Hotpot");
      }
      if (has("sukiyaki")) {
        addCuisineTag(outlet, "Sukiyaki");
        addCuisineTag(outlet, "Hotpot");
      }
      if (has("steamboat")) {
        addCuisineTag(outlet, "Steamboat");
        addCuisineTag(outlet, "Hotpot");
      }
      if (has("hotpot", "hot pot")) {
        addCuisineTag(outlet, "Hotpot");
      }
      if (has("mookata")) { addCuisineTag(outlet, "Mookata"); addCuisineTag(outlet, "Hotpot"); }
    });

