      if (stepNum === 1) {
        // Normalise any legacy or restored multi-cuisine state to one choice.
        if (Array.isArray(ansObj.cuisines) && ansObj.cuisines.length > 1) {
          ansObj.cuisines = [ansObj.cuisines[ansObj.cuisines.length - 1]];
        }
        const visibleFamilies = showAllCuisinesFlag ? CUISINE_FAMILIES : CUISINE_FAMILIES.slice(0, 6);
