          locNote = `Either ${p1.selectedMall} or ${p2.selectedMall}`;
          return outlet.mall === p1.selectedMall || outlet.mall === p2.selectedMall;
        }
        if (p1.locationMode === "mall") {
          locNote = `Anchored to Person 1's mall (${p1.selectedMall})`;
          return outlet.mall === p1.selectedMall;
        }
        if (p2.locationMode === "mall") {
          locNote = `Anchored to Person 2's mall (${p2.selectedMall})`;
          return outlet.mall === p2.selectedMall;
        }
        if (p1.locationMode === "region" && p2.locationMode === "region") {
          if (p1.selectedRegion === p2.selectedRegion) {
            locNote = `Both chose ${p1.selectedRegion} Singapore`;
            return getMallRegion(outlet.mall) === p1.selectedRegion;
          }
          locNote = `${p1.selectedRegion} or ${p2.selectedRegion} Singapore`;
          return getMallRegion(outlet.mall) === p1.selectedRegion || getMallRegion(outlet.mall) === p2.selectedRegion;
        }
        if (p1.locationMode === "region") {
          locNote = `${p1.selectedRegion} Singapore (Person 2 flexible)`;
          return getMallRegion(outlet.mall) === p1.selectedRegion;
        }
        if (p2.locationMode === "region") {
          locNote = `${p2.selectedRegion} Singapore (Person 1 flexible)`;
          return getMallRegion(outlet.mall) === p2.selectedRegion;
        }
        return true;
      }

      const budgetRank = { any: 0, budget: 1, mid: 2, splurge: 3 };
      let effectiveBudget = "any";
      let budgetNote = "Flexible budget for both";
      if (p1.budget !== "any" && p2.budget !== "any") {
        effectiveBudget = budgetRank[p1.budget] <= budgetRank[p2.budget] ? p1.budget : p2.budget;
        budgetNote = p1.budget === p2.budget
          ? `Both agreed on ${effectiveBudget.toUpperCase()} tier`
          : `Respecting the more comfortable budget tier (${effectiveBudget.toUpperCase()})`;
      } else if (p1.budget !== "any") {
        effectiveBudget = p1.budget;
        budgetNote = `Following Person 1's budget (${p1.budget.toUpperCase()})`;
      } else if (p2.budget !== "any") {
        effectiveBudget = p2.budget;
        budgetNote = `Following Person 2's budget (${p2.budget.toUpperCase()})`;
      }

      const diningNote = "No dining occasion restriction";

      const pool = OUTLETS.filter(outlet => {
        if (excludeSeen && state.seenIds.has(outlet.id)) return false;
        if (combinedExclusions.some(famId => matchesCuisineFamily(outlet, famId))) return false;
        if (cuisineStrategy !== "any" && targetCuisines.length > 0) {
          if (!targetCuisines.some(famId => matchesCuisineFamily(outlet, famId))) return false;
        }
        if (!matchesCoupleLocation(outlet)) return false;
        if (!matchesBudget(outlet, effectiveBudget)) return false;
        return true;
      });

      const explanation = {
        cuisineStrategy,
        cuisineNote,
        locNote,
        budgetNote,
        diningNote,
        combinedExclusions
      };
      state.couple.matchExplanation = explanation;
      return { pool, explanation };
    }

    function getMatchingOutlets(options = {}) {
      if (state.mode === "couple") {
        const res = computeCoupleCompatiblePool(options);
        state.lastExplanation = res.explanation;
        return res.pool;
      } else {
        state.lastExplanation = null;
        return filterOutletsBySingleAnswers(state.answers, options);
      }
    }

    // =========================================================================
    // 10. SHARED QUESTION STEP RENDERER (WORKS FOR SOLO, P1 & P2)
    // =========================================================================
    const BUDGET_OPTIONS = [
      { id: "budget", emoji: "🪙", title: "Budget-Friendly ($)", sub: "Hawker halls, fast casual, cafes & light bites" },
      { id: "mid", emoji: "💳", title: "Casual Mid-Range ($$)", sub: "Everyday sit-down restaurants & brunch cafes" },
      { id: "splurge", emoji: "🥂", title: "Special Treat / Splurge ($$$)", sub: "Steakhouses, Wagyu, seafood & celebratory dining" },
      { id: "any", emoji: "🌈", title: "Any Budget", sub: "Show all price ranges" }
    ];

    function getAvailableMallsWithCounts() {
      const counts = {};
      OUTLETS.forEach(o => { counts[o.mall] = (counts[o.mall] || 0) + 1; });
      return Object.entries(counts)
        .map(([mall, count]) => ({ mall, count, region: getMallRegion(mall) }))
        .sort((a, b) => b.count - a.count || a.mall.localeCompare(b.mall));
    }

    function renderQuestionBody(container, ansObj, stepNum, {
      personaLabel = "",
      showAllCuisinesFlag = false,
      onToggleMoreCuisines,
      onNextStep,
      onOpenGachapon
