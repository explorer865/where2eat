    class GachaSoundEngine {
      constructor() { this.ctx = null; this.enabled = true; }
      ensureCtx() {
        if (!this.enabled) return null;
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === "suspended") this.ctx.resume().catch(() => {});
        return this.ctx;
      }
      playTick(freq = 560, duration = 0.03) {
        const ctx = this.ensureCtx(); if (!ctx) return;
        const now = ctx.currentTime;
        const osc = ctx.createOscillator(); const gain = ctx.createGain();
        osc.type = "triangle";
        osc.frequency.setValueAtTime(freq, now);
        osc.frequency.exponentialRampToValueAtTime(freq * 0.45, now + duration);
        gain.gain.setValueAtTime(0.11, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);
        osc.connect(gain); gain.connect(ctx.destination);
        osc.start(now); osc.stop(now + duration);
      }
      playCrankTurn() { [0, 75, 150, 235, 325].forEach((ms, idx) => setTimeout(() => this.playTick(400 + idx * 55, 0.045), ms)); }
      playCapsuleRattle(durationMs = 1050) {
        const start = performance.now();
        const step = () => {
          if (!this.enabled || performance.now() - start > durationMs) return;
          this.playTick(260 + Math.random() * 240, 0.03);
          setTimeout(step, 65 + Math.random() * 55);
        };
        step();
      }
      playCapsuleDrop() {
        const ctx = this.ensureCtx(); if (!ctx) return;
        [0, 175, 310].forEach((delay, idx) => {
          setTimeout(() => {
            const now = ctx.currentTime;
            const osc = ctx.createOscillator(); const gain = ctx.createGain();
            osc.type = "sine";
            const base = 310 - idx * 45;
            osc.frequency.setValueAtTime(base, now);
            osc.frequency.exponentialRampToValueAtTime(base * 0.55, now + 0.11);
            gain.gain.setValueAtTime(0.16 / (idx + 1), now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
            osc.connect(gain); gain.connect(ctx.destination);
            osc.start(now); osc.stop(now + 0.13);
          }, delay);
        });
      }
      playCapsulePopAndChime(isGolden = false) {
        const ctx = this.ensureCtx(); if (!ctx) return;
        const now = ctx.currentTime;
        const popOsc = ctx.createOscillator(); const popGain = ctx.createGain();
        popOsc.type = "sine";
        popOsc.frequency.setValueAtTime(220, now);
        popOsc.frequency.exponentialRampToValueAtTime(640, now + 0.08);
        popGain.gain.setValueAtTime(0.18, now);
        popGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
        popOsc.connect(popGain); popGain.connect(ctx.destination);
        popOsc.start(now); popOsc.stop(now + 0.1);

        const notes = isGolden ? [523.25, 659.25, 783.99, 1046.50, 1318.51] : [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((freq, idx) => {
          const t = now + 0.07 + idx * 0.075;
          const osc = ctx.createOscillator(); const gain = ctx.createGain();
          osc.type = "triangle"; osc.frequency.setValueAtTime(freq, t);
          gain.gain.setValueAtTime(0.001, t);
          gain.gain.linearRampToValueAtTime(0.14, t + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, t + 0.42);
          osc.connect(gain); gain.connect(ctx.destination);
          osc.start(t); osc.stop(t + 0.44);
        });
      }
    }
