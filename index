            }).join("")}
            <div class="cuisine-card surprise ${ansObj.surpriseMe ? "selected" : ""}" data-surprise="true">
              <div class="cuisine-icon">🎲</div>
              <div class="cuisine-name">Surprise Me!</div>
              <div class="cuisine-count">All ${OUTLETS.length} spots</div>
            </div>
          </div>
          <div class="more-cuisines-row">
            <button type="button" class="ghost-pill" id="qToggleMoreCuisinesBtn">
