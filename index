    function computeCoupleCompatiblePool({ ignoreRepeats = false } = {}) {
      const p1 = state.couple.p1;
      const p2 = state.couple.p2;
      const excludeSeen = !ignoreRepeats && document.getElementById("excludeSeenCheckbox")?.checked;

      const combinedExclusions = Array.from(new Set([...p1.excludedCuisines, ...p2.excludedCuisines]));

      const p1Any = p1.surpriseMe || p1.cuisines.length === 0;
      const p2Any = p2.surpriseMe || p2.cuisines.length === 0;
      const sharedCuisines = p1.cuisines.filter(c => p2.cuisines.includes(c));
      const unionCuisines = Array.from(new Set([...p1.cuisines, ...p2.cuisines]));

      let cuisineStrategy = "any";
      let targetCuisines = [];
      let cuisineNote = "Both open to any delicious surprise";

      if (p1Any && p2Any) {
        cuisineStrategy = "any";
        cuisineNote = "Both partners chose Surprise Me / Any Cuisine";
      } else if (p1Any) {
        cuisineStrategy = "p2_only";
        targetCuisines = p2.cuisines;
        cuisineNote = `Person 1 was flexible — honoring Person 2's cravings (${p2.cuisines.join(", ")})`;
      } else if (p2Any) {
        cuisineStrategy = "p1_only";
        targetCuisines = p1.cuisines;
        cuisineNote = `Person 2 was flexible — honoring Person 1's cravings (${p1.cuisines.join(", ")})`;
      } else if (sharedCuisines.length > 0) {
        cuisineStrategy = "intersection";
        targetCuisines = sharedCuisines;
        cuisineNote = `Exact craving match! Both love ${sharedCuisines.join(", ")}`;
      } else {
        cuisineStrategy = "union";
        targetCuisines = unionCuisines;
        cuisineNote = `Best-of-both-worlds blend (${p1.cuisines.join(", ")}) + (${p2.cuisines.join(", ")})`;
      }

      let locNote = "Anywhere across Singapore";
      function matchesCoupleLocation(outlet) {
        if (p1.locationMode === "mall" && p2.locationMode === "mall") {
          if (p1.selectedMall === p2.selectedMall) {
            locNote = `Both chose ${p1.selectedMall}`;
